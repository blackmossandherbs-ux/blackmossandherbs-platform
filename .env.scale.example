# Scaling Configuration
# Copy to .env.scale and configure

# Instance Identification
INSTANCE_ID=web-1

# Database - Primary (Write)
DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/blackmoss_herbs?schema=public&pgbouncer=true

# Database - Direct (for migrations)
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/blackmoss_herbs?schema=public

# Database - Read Replica (for read queries)
DATABASE_REPLICA_URL=postgresql://postgres:postgres@pgbouncer-replica:6432/blackmoss_herbs?schema=public&pgbouncer=true

# Redis - Cache
REDIS_URL=redis://redis:6379

# Redis - Sessions (separate DB)
REDIS_SESSION_URL=redis://redis:6379/1

# Redis - Queue (separate DB)
REDIS_QUEUE_URL=redis://redis:6379/2

# CDN Configuration
CDN_ENABLED=true
CDN_URL=https://cdn.blackmossandherbs.com
CDN_PROVIDER=cloudflare

# Cloudflare (if using Cloudflare CDN)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=blackmossandherbs.com

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
GRAFANA_PASSWORD=change-this-in-production

# Auto-scaling
AUTO_SCALE_ENABLED=true
AUTO_SCALE_MIN_REPLICAS=2
AUTO_SCALE_MAX_REPLICAS=10
AUTO_SCALE_CPU_THRESHOLD=70
AUTO_SCALE_MEMORY_THRESHOLD=80

# Load Balancer
LOAD_BALANCER_ENABLED=true
LOAD_BALANCER_ALGORITHM=least_conn

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s

# Rate Limiting (Redis-based)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Queue Workers
QUEUE_WORKER_REPLICAS=2
QUEUE_WORKER_CONCURRENCY=5

# Database Pooling
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_POOL_IDLE_TIMEOUT=30000

# Read Replicas
READ_REPLICA_ENABLED=true
READ_REPLICA_COUNT=2

# Kubernetes (if using K8s)
KUBERNETES_NAMESPACE=blackmoss-production
KUBERNETES_CLUSTER=production

# Docker Swarm (if using Swarm)
SWARM_STACK_NAME=blackmoss
SWARM_NETWORK=blackmoss_network
