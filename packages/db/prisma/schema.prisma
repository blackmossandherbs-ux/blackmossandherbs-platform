// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & AUTHORIZATION
// ============================================

enum UserRole {
  CUSTOMER
  STAFF
  PRACTITIONER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String? // null for OAuth users
  image         String?
  role          UserRole    @default(CUSTOMER)
  status        UserStatus  @default(PENDING_VERIFICATION)
  phone         String?
  timezone      String      @default("UTC")
  locale        String      @default("en")
  
  // 2FA
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  backupCodes      String[]  @default([])
  
  // Timestamps
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  subscriptions Subscription[]
  downloads     Download[]
  consultations Consultation[] @relation("CustomerConsultations")
  practitionerProfile PractitionerProfile?
  cartItems     CartItem[]
  reviews       Review[]
  supportTickets SupportTicket[]
  auditLogs     AuditLog[]
  aiConversations AIConversation[]
  loyaltyPoints LoyaltyPoint[]
  referrals     Referral[] @relation("Referrer")
  referredBy    Referral[] @relation("Referred")
  
  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// PRODUCTS & INVENTORY
// ============================================

enum ProductType {
  PHYSICAL
  DIGITAL
  BUNDLE
  SUBSCRIPTION_BOX
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  shortDescription String?  @db.Text
  type        ProductType
  status      ProductStatus @default(DRAFT)
  
  // Pricing
  basePrice   Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?   @db.Decimal(10, 2)
  memberPrice Decimal?      @db.Decimal(10, 2)
  
  // Inventory (for physical products)
  trackInventory Boolean    @default(true)
  inventoryCount Int?       @default(0)
  lowStockThreshold Int?    @default(10)
  
  // Digital product settings
  isDownloadable Boolean    @default(false)
  downloadLimit  Int?       // null = unlimited
  downloadExpiryDays Int?   // null = never expires
  
  // SEO
  metaTitle       String?
  metaDescription String?   @db.Text
  
  // Media
  images          String[]  @default([])
  featuredImage   String?
  
  // Relations
  variants        ProductVariant[]
  categories      ProductCategory[]
  tags            ProductTag[]
  bundles         BundleProduct[] @relation("BundleProducts")
  bundleItems     BundleProduct[] @relation("BundleItems")
  reviews         Review[]
  faqs            ProductFAQ[]
  relatedProducts ProductRelation[] @relation("SourceProduct")
  relatedTo       ProductRelation[] @relation("RelatedProduct")
  orderItems      OrderItem[]
  cartItems       CartItem[]
  routines        RoutineProduct[]
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?
  
  @@index([slug])
  @@index([status])
  @@index([type])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  name        String   // e.g., "500g", "1kg", "Digital PDF"
  sku         String?  @unique
  price       Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  inventoryCount Int?  @default(0)
  trackInventory Boolean @default(true)
  weight      Decimal? @db.Decimal(8, 2) // in grams
  dimensions  Json?    // {length, width, height}
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  cartItems   CartItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  parentId    String?
  parent      ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]
  image       String?
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([parentId])
  @@map("product_categories")
}

model ProductTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  products  Product[]
  
  createdAt DateTime @default(now())
  
  @@index([slug])
  @@map("product_tags")
}

model ProductFAQ {
  id        String   @id @default(cuid())
  productId String
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([productId])
  @@map("product_faqs")
}

model ProductRelation {
  id            String   @id @default(cuid())
  sourceProductId String
  relatedProductId String
  relationType  String   // "pairs_well_with", "complete_routine", "frequently_bought_together"
  
  sourceProduct Product  @relation("SourceProduct", fields: [sourceProductId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@unique([sourceProductId, relatedProductId, relationType])
  @@index([sourceProductId])
  @@map("product_relations")
}

model BundleProduct {
  id          String   @id @default(cuid())
  bundleId    String
  productId   String
  quantity    Int      @default(1)
  discount    Decimal? @db.Decimal(5, 2) // percentage discount
  
  bundle      Product  @relation("BundleProducts", fields: [bundleId], references: [id], onDelete: Cascade)
  product     Product  @relation("BundleItems", fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@unique([bundleId, productId])
  @@index([bundleId])
  @@map("bundle_products")
}

// ============================================
// ORDERS & CHECKOUT
// ============================================

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShippingStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  email           String
  phone           String?
  
  // Status
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  shippingStatus  ShippingStatus @default(PENDING)
  
  // Pricing
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2) @default(0)
  shipping        Decimal       @db.Decimal(10, 2) @default(0)
  discount        Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  
  // Payment
  stripePaymentIntentId String?
  stripeChargeId       String?
  paymentMethod         String?
  
  // Shipping
  shippingAddress  Json
  billingAddress   Json
  
  // Digital products
  isDigitalOnly   Boolean       @default(false)
  
  // Relations
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  shipments       Shipment[]
  refunds         Refund[]
  invoices        Invoice[]
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  
  @@index([orderNumber])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  name            String
  sku             String?
  quantity        Int
  price           Decimal  @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  isDigital       Boolean  @default(false)
  
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Shipment {
  id              String   @id @default(cuid())
  orderId         String
  trackingNumber  String?
  carrier         String?
  status          ShippingStatus @default(PENDING)
  shippedAt       DateTime?
  deliveredAt     DateTime?
  trackingUrl     String?
  
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model Refund {
  id              String   @id @default(cuid())
  orderId         String
  amount          Decimal  @db.Decimal(10, 2)
  reason          String?  @db.Text
  status          String   @default("pending") // pending, processed, failed
  stripeRefundId  String?
  
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  processedAt     DateTime?
  
  @@index([orderId])
  @@map("refunds")
}

model Invoice {
  id              String   @id @default(cuid())
  orderId         String
  invoiceNumber   String   @unique
  pdfUrl          String?
  
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@index([orderId])
  @@index([invoiceNumber])
  @@map("invoices")
}

model CartItem {
  id              String   @id @default(cuid())
  userId          String
  productId       String
  variantId       String?
  quantity        Int      @default(1)
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([userId, productId, variantId])
  @@index([userId])
  @@map("cart_items")
}

// ============================================
// SUBSCRIPTIONS
// ============================================

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum SubscriptionFrequency {
  MONTHLY
  BIWEEKLY
  QUARTERLY
  YEARLY
}

model Subscription {
  id              String              @id @default(cuid())
  userId          String
  status          SubscriptionStatus  @default(ACTIVE)
  frequency       SubscriptionFrequency @default(MONTHLY)
  
  // Product/Box
  productId      String?
  boxName        String?
  boxDescription String? @db.Text
  
  // Pricing
  price          Decimal             @db.Decimal(10, 2)
  discount       Decimal?            @db.Decimal(5, 2) // percentage
  
  // Stripe
  stripeSubscriptionId String?       @unique
  stripeCustomerId     String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  cancelledAt          DateTime?
  
  // Customer controls
  nextShipmentDate     DateTime?
  skipNextShipment     Boolean       @default(false)
  swapProducts         Json?        // array of product swaps
  
  // Shipping
  shippingAddress      Json
  
  // Relations
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders               SubscriptionOrder[]
  
  // Timestamps
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model SubscriptionOrder {
  id              String   @id @default(cuid())
  subscriptionId  String
  orderId         String   @unique
  
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@index([subscriptionId])
  @@index([orderId])
  @@map("subscription_orders")
}

// ============================================
// DIGITAL PRODUCTS & DOWNLOADS
// ============================================

model DigitalProduct {
  id              String   @id @default(cuid())
  productId       String   @unique
  fileUrl         String
  fileName        String
  fileSize        Int      // bytes
  mimeType        String
  version         String   @default("1.0.0")
  isWatermarked   Boolean  @default(false)
  downloadLimit   Int?     // null = unlimited
  expiryDays      Int?     // null = never expires
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([productId])
  @@map("digital_products")
}

model Download {
  id              String   @id @default(cuid())
  userId          String
  productId       String
  digitalProductId String?
  orderId         String?
  
  // Download tracking
  downloadUrl     String   // signed, expiring URL
  expiresAt       DateTime
  downloadCount   Int      @default(0)
  maxDownloads    Int      @default(5)
  lastDownloadedAt DateTime?
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@map("downloads")
}

// ============================================
// CONTENT (BLOG/NEWS)
// ============================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  ARTICLE
  GUIDE
  NEWS
  RECIPE
}

model Content {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt          String?      @db.Text
  content         String        @db.Text
  type            ContentType   @default(ARTICLE)
  status          ContentStatus @default(DRAFT)
  
  // SEO
  metaTitle       String?
  metaDescription String?      @db.Text
  
  // Media
  featuredImage   String?
  images          String[]      @default([])
  
  // Authoring
  authorId        String?
  authorName      String?
  
  // Relations
  categories      ContentCategory[]
  tags            ContentTag[]
  relatedContent  ContentRelation[] @relation("SourceContent")
  relatedTo       ContentRelation[] @relation("RelatedContent")
  
  // Publishing
  publishedAt     DateTime?
  scheduledAt     DateTime?
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([slug])
  @@index([status])
  @@index([type])
  @@index([publishedAt])
  @@map("content")
}

model ContentCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  parentId    String?
  parent      ContentCategory? @relation("ContentCategoryHierarchy", fields: [parentId], references: [id])
  children    ContentCategory[] @relation("ContentCategoryHierarchy")
  content     Content[]
  image       String?
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@map("content_categories")
}

model ContentTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  content   Content[]
  
  createdAt DateTime @default(now())
  
  @@index([slug])
  @@map("content_tags")
}

model ContentRelation {
  id            String   @id @default(cuid())
  sourceContentId String
  relatedContentId String
  relationType  String   // "related", "series", "prerequisite"
  
  sourceContent Content  @relation("SourceContent", fields: [sourceContentId], references: [id], onDelete: Cascade)
  relatedContent Content @relation("RelatedContent", fields: [relatedContentId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@unique([sourceContentId, relatedContentId, relationType])
  @@index([sourceContentId])
  @@map("content_relations")
}

// ============================================
// VIDEO HUB
// ============================================

enum VideoAccess {
  FREE
  MEMBER_ONLY
  PAID
}

model Video {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String?     @db.Text
  videoUrl        String
  thumbnailUrl    String?
  duration        Int?        // seconds
  access          VideoAccess @default(FREE)
  
  // Series/Episodes
  seriesId        String?
  series          VideoSeries? @relation(fields: [seriesId], references: [id])
  episodeNumber   Int?
  
  // Chapters
  chapters        VideoChapter[]
  
  // Transcript
  transcript      String?     @db.Text
  
  // Relations
  products        VideoProduct[]
  tags            VideoTag[]
  
  // Publishing
  publishedAt     DateTime?
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([slug])
  @@index([seriesId])
  @@index([access])
  @@map("videos")
}

model VideoSeries {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  thumbnailUrl String?
  videos      Video[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@map("video_series")
}

model VideoChapter {
  id          String   @id @default(cuid())
  videoId     String
  title       String
  startTime   Int      // seconds
  endTime     Int?     // seconds
  order       Int      @default(0)
  
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@index([videoId])
  @@map("video_chapters")
}

model VideoProduct {
  id          String   @id @default(cuid())
  videoId     String
  productId   String
  
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@unique([videoId, productId])
  @@index([videoId])
  @@map("video_products")
}

model VideoTag {
  id        String   @id @default(cuid())
  name      String   @unique
  videos    Video[]
  
  createdAt DateTime @default(now())
  
  @@map("video_tags")
}

// ============================================
// CONSULTATIONS
// ============================================

enum ConsultationStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model PractitionerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?  @db.Text
  specialties      String[] @default([])
  qualifications   String[] @default([])
  languages        String[] @default([])
  timezone         String   @default("UTC")
  consultationPrice Decimal @db.Decimal(10, 2)
  currency         String   @default("USD")
  isActive         Boolean  @default(true)
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations   Consultation[]
  schedules       ConsultationSchedule[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@map("practitioner_profiles")
}

model ConsultationSchedule {
  id              String   @id @default(cuid())
  practitionerId  String
  dayOfWeek       Int      // 0-6 (Sunday-Saturday)
  startTime       String   // HH:mm format
  endTime         String   // HH:mm format
  timezone        String
  isAvailable     Boolean  @default(true)
  
  practitioner    PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([practitionerId])
  @@map("consultation_schedules")
}

model Consultation {
  id              String            @id @default(cuid())
  customerId      String
  practitionerId  String
  status          ConsultationStatus @default(PENDING)
  
  // Booking
  scheduledAt     DateTime
  duration        Int               @default(60) // minutes
  timezone        String
  
  // Intake
  intakeForm      Json?             // form responses
  consentAccepted Boolean           @default(false)
  policiesAccepted Json?            // array of policy IDs
  
  // Payment
  price           Decimal           @db.Decimal(10, 2)
  currency        String            @default("USD")
  stripePaymentIntentId String?
  paidAt          DateTime?
  
  // Session
  meetingUrl      String?
  meetingPassword String?
  notes           String?           @db.Text
  outcome         String?           @db.Text
  
  // Follow-up
  followUpPlan    Json?             // recommended products, routines, next steps
  recommendedProducts String[]      @default([])
  
  // Relations
  customer        User              @relation("CustomerConsultations", fields: [customerId], references: [id], onDelete: Cascade)
  practitioner    PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  confirmedAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  
  @@index([customerId])
  @@index([practitionerId])
  @@index([status])
  @@index([scheduledAt])
  @@map("consultations")
}

// ============================================
// MEMBERSHIP & LOYALTY
// ============================================

model LoyaltyPoint {
  id              String   @id @default(cuid())
  userId          String
  points          Int
  reason          String   // "purchase", "referral", "review", "admin_adjustment"
  orderId         String?
  expiresAt       DateTime?
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([orderId])
  @@map("loyalty_points")
}

model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referredId      String   @unique
  code            String
  rewardGiven     Boolean  @default(false)
  
  referrer        User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred        User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  rewardedAt      DateTime?
  
  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

// ============================================
// ROUTINES
// ============================================

model Routine {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  userId          String?  // null = public/default routine
  isPublic        Boolean  @default(false)
  products        RoutineProduct[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@map("routines")
}

model RoutineProduct {
  id          String   @id @default(cuid())
  routineId   String
  productId   String
  order       Int      @default(0)
  instructions String? @db.Text
  
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@index([routineId])
  @@map("routine_products")
}

// ============================================
// REVIEWS & RATINGS
// ============================================

model Review {
  id              String   @id @default(cuid())
  userId          String
  productId       String
  rating          Int      // 1-5
  title           String?
  comment         String?  @db.Text
  isVerified      Boolean  @default(false) // purchased product
  isPublished     Boolean  @default(false)
  helpfulCount     Int      @default(0)
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
  @@map("reviews")
}

// ============================================
// SUPPORT & TICKETS
// ============================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id              String        @id @default(cuid())
  userId          String
  subject         String
  message         String        @db.Text
  status          TicketStatus  @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  assignedToId    String?
  
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  resolvedAt      DateTime?
  
  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

// ============================================
// ADMIN & AUDIT
// ============================================

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String   // "create", "update", "delete", "login", etc.
  entityType      String   // "product", "order", "user", etc.
  entityId        String?
  changes         Json?    // before/after snapshot
  ipAddress       String?
  userAgent       String?
  
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// AI SYSTEM
// ============================================

enum AIProvider {
  OLLAMA
  OPENAI
  ANTHROPIC
  GOOGLE
  HUGGINGFACE
}

model AIConversation {
  id              String   @id @default(cuid())
  userId          String?
  sessionId       String   // for anonymous users
  messages        Json     // array of {role, content, timestamp}
  provider        AIProvider?
  model           String?
  tokensUsed      Int      @default(0)
  cost            Decimal? @db.Decimal(10, 6)
  cached          Boolean  @default(false)
  
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_conversations")
}

model AICache {
  id              String   @id @default(cuid())
  queryHash       String   @unique // hash of user query
  response        String   @db.Text
  provider        AIProvider
  model           String
  tokensUsed      Int
  hitCount        Int      @default(0)
  expiresAt       DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([queryHash])
  @@index([expiresAt])
  @@map("ai_cache")
}

// ============================================
// FEATURE FLAGS & CONFIG
// ============================================

model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String?  @db.Text
  enabled         Boolean  @default(false)
  conditions      Json?    // targeting rules
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([key])
  @@map("feature_flags")
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?  @db.Text
  discountType    String   // "percentage", "fixed"
  discountValue   Decimal  @db.Decimal(10, 2)
  minPurchase     Decimal? @db.Decimal(10, 2)
  maxDiscount     Decimal? @db.Decimal(10, 2)
  usageLimit      Int?
  usedCount       Int      @default(0)
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([code])
  @@index([isActive])
  @@map("coupons")
}
