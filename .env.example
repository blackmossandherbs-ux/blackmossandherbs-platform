# Database
DATABASE_URL="postgresql://user:password@localhost:5432/blackmossandherbs"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Stripe (required for checkout & subscriptions)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe subscription Price IDs (create these in the Stripe dashboard).
# Each maps to a plan on the /subscriptions page.
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PLUS="price_..."
STRIPE_PRICE_PRO="price_..."

# Email / SMTP (used by contact form, newsletter, abandoned-cart, welcome email)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="username"
EMAIL_SERVER_PASSWORD="password"
EMAIL_FROM="noreply@blackmossandherbs.com"
# Where contact-form and newsletter notifications are delivered (defaults to EMAIL_FROM)
CONTACT_INBOX="support@blackmossandherbs.com"
NEWSLETTER_INBOX="hello@blackmossandherbs.com"

# Cron (abandoned-cart recovery)
CRON_SECRET="generate-a-random-secret"

# Seed admin account (used by `npm run db:seed`)
ADMIN_EMAIL="admin@blackmossandherbs.com"
ADMIN_PASSWORD="change-me-before-launch"

# AI — powers the "Mr. Moss" guide chat and AI article generation.
# Pick a provider and add keys in the admin panel (Admin → AI Settings), OR set
# them here. Every provider supports key rotation: PREFIX, PREFIX_2..10, or a
# comma-separated PREFIXS list. Free providers (recommended):
#
#   Groq (free, very fast)   -> get a key at console.groq.com
# GROQ_API_KEY="gsk_..."
# GROQ_API_KEY_2="gsk_..."
# GROQ_API_KEYS="gsk_a,gsk_b,gsk_c"
#
#   OpenRouter (free models) -> get a key at openrouter.ai (use a :free model)
# OPENROUTER_API_KEY="sk-or-..."
#
#   Google Gemini (free tier)-> get a key at aistudio.google.com
# GEMINI_API_KEY="..."
#
#   Anthropic Claude (paid, optional)
# ANTHROPIC_API_KEY="sk-ant-..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SEO — paste the token from Google Search Console to verify the site
# GOOGLE_SITE_VERIFICATION="..."
