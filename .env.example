# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blackmoss_herbs?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# Redis (Upstash or local)
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Storage (Cloudflare R2 or S3)
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="blackmoss-herbs"
R2_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@blackmossandherbs.com"
EMAIL_FROM_NAME="BlackMoss & Herbs"

# Search (Meilisearch)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY=""

# AI Providers (optional - defaults to Ollama)
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
AI_DAILY_TOKEN_LIMIT="1000000"
AI_ENABLE_OPENAI="false"
AI_ENABLE_ANTHROPIC="false"
AI_ENABLE_GOOGLE="false"

# Sentry
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Admin
ADMIN_EMAIL="admin@blackmossandherbs.com"
ADMIN_PASSWORD="change-this-in-production"

# Security
ENCRYPTION_KEY="change-this-to-32-char-random-string"
SESSION_SECRET="change-this-to-random-secret"
