# Database
DATABASE_URL="postgresql://user:password@localhost:5432/blackmossandherbs"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Stripe (required for checkout & subscriptions)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe subscription Price IDs (create these in the Stripe dashboard).
# Each maps to a plan on the /subscriptions page.
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PLUS="price_..."
STRIPE_PRICE_PRO="price_..."

# Email / SMTP (used by contact form, newsletter, abandoned-cart, welcome email)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="username"
EMAIL_SERVER_PASSWORD="password"
EMAIL_FROM="noreply@blackmossandherbs.com"
# Where contact-form and newsletter notifications are delivered (defaults to EMAIL_FROM)
CONTACT_INBOX="support@blackmossandherbs.com"
NEWSLETTER_INBOX="hello@blackmossandherbs.com"

# Cron (abandoned-cart recovery)
CRON_SECRET="generate-a-random-secret"

# Seed admin account (used by `npm run db:seed`)
ADMIN_EMAIL="admin@blackmossandherbs.com"
ADMIN_PASSWORD="change-me-before-launch"

# AI (Claude) — powers article generation and the on-site botanical guide chat
ANTHROPIC_API_KEY="sk-ant-..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google services (all free tiers; each is skipped entirely if unset) ---

# Google Analytics 4 — from analytics.google.com, Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Search Console — Settings > Ownership verification > HTML tag,
# paste just the content="..." value
GOOGLE_SITE_VERIFICATION=""

# Google Sign-In — from console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps embed on /contact — plain postal address, no API key needed.
# Leave unset to hide the map (there's no real address to show otherwise).
NEXT_PUBLIC_BUSINESS_ADDRESS=""

# Google reCAPTCHA v3 — from google.com/recaptcha/admin (spam protection on
# the contact form)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
