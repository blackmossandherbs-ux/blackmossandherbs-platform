# ==========================================
# BLACK MOSS & HERBS - .gitignore
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/
.npm/

# Testing
/coverage
.nyc_output
*.lcov
test-results/
playwright-report/

# Next.js
/.next/
/out/
.next/
next-env.d.ts

# Production builds
/build
/dist

# Environment variables (NEVER commit)
.env
.env*.local
.env.production
.env.development

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Debug
.vscode-test

# TypeScript
*.tsbuildinfo
.tsbuildinfo

# Certificates and keys (NEVER commit)
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Database
prisma/migrations/
*.db
*.sqlite
*.sqlite3

# Backups
*.bak
*.backup
*.sql.gz
/backups/

# Docker
.docker/
docker-compose.override.yml

# Temporary files
tmp/
temp/
.cache/
.tmp/

# Package manager lock files (keep only one)
# Uncomment the ones you don't use:
# yarn.lock
# pnpm-lock.yaml

# Build artifacts
*.tgz

# Deployment
.vercel
.netlify

# Monitoring and APM
newrelic_agent.log
.elasticbeanstalk/

# Local configuration
.local/

# Generated files
/generated/

# Coverage reports
htmlcov/
.coverage
.coverage.*

# Documentation builds
/docs/_build/
site/

# Prisma Studio
.prisma/
