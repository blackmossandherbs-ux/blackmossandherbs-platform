# ==========================================
# BLACK MOSS & HERBS - .dockerignore
# Optimize Docker build performance
# ==========================================

# Version control
.git
.gitignore
.gitattributes

# Dependencies (will be installed in container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs (will be built in container)
.next
out
build
dist
.cache

# Environment files (mount at runtime)
.env
.env.*
.env*.local
!.env.example

# Testing
coverage
.nyc_output
test-results
playwright-report
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
__mocks__

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.project
.classpath
.settings
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
.Spotlight-V100
.Trashes

# Documentation (exclude to reduce image size)
*.md
!README.md
docs/
.github/

# Scripts (keep only essential)
scripts/
!scripts/validate-env.js

# Logs
*.log
logs/

# Backups
*.bak
*.backup
*.sql
*.sql.gz
backups/

# Temporary files
tmp/
temp/
.tmp/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
circle.yml
.circleci/

# Docker files (not needed in image)
Dockerfile
docker-compose*.yml
.dockerignore

# Kubernetes
k8s/
*.yaml
*.yml
!package.json

# Database
*.db
*.sqlite
*.sqlite3
prisma/migrations/

# Certificates
*.pem
*.key
*.cert
*.crt

# Deployment configs (server-side only)
deploy*.sh
server-manager.sh
setup*.sh
maintain.sh
auto-deploy.sh

# Project documentation
LICENSE
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
PROJECT_ISOLATION.md
WHATS_FIXED.md
LAUNCH_CHECKLIST.md
SERVER_*.md
QUICKSTART.md
